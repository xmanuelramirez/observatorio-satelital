# Salida de HyP3: los GeoTIFF de subsidencia no van al repositorio
public/insar/

# Capas internas del departamento. Se quedan en disco para el trabajo local,
# pero no viajan al repositorio: en un repo publico el fuente se lee igual que
# el sitio, asi que excluirlas solo del build no bastaria.
public/capas/EMA.geojson
public/capas/SENSORES_ARROYOS.geojson
public/capas/NUMERO_DE_CURVA_MARCO_V1.geojson
# Su descripcion viaja con ella: cita rutas internas del portafolio y no tiene
# sentido en un repositorio sin la capa que describe.
public/capas/LEEME-NUMERO_DE_CURVA_MARCO_V1.txt
# El nombre anterior sigue excluido: si alguien vuelve a copiar la capa con el
# nombre viejo desde 0. CAPAS VARIAS, tampoco debe llegar al repositorio.
public/capas/NUMERO_DE_CURVA.geojson
public/capas/LEEME-NUMERO_DE_CURVA.txt

# Ningun .env al repositorio, aunque solo traiga banderas.
.env
.env.*

# Temporales de wrangler pages dev
.wrangler/

# Ordenes del MASTER: no se versionan (orden del 23/09/2026).
ORDENES-DEL-MASTER/

# Tablas que produce medir-poligonos: se generan, no se versionan.
salidas/

# Entregables del contrato. El repositorio es publico y estos documentos
# describen sistemas internos, rutas del portafolio y el estado de insumos que
# todavia no son publicos. Viven en disco y viajan por los canales del
# departamento, no por GitHub.
ENTREGABLES/

# Insumos que entrega SAPAL o el departamento (p. ej. zonas de recarga potencial). Se guardan
# con su huella para trabajar en local, nunca en el repositorio.
insumos-sapal/
